# 复制为 .env 后按需填写。模型提供商在 Web UI「模型与通用配置」中保存，不读下面的中转站变量。

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173"]

DATABASE_URL=sqlite+aiosqlite:///./data/yunxiao_agent.db
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT=1800
WORKTREES_DIR=.worktrees
LOG_LEVEL=INFO
PI_NODE_COMMAND=node

# 云效。界面保存的 data/yunxiao_config.json 优先于这里。
YUNXIAO_API_BASE=https://openapi-rdc.aliyuncs.com
YUNXIAO_ACCESS_TOKEN=your-token
YUNXIAO_ORG_ID=your-org-id
# * 表示同步该组织下所有可访问项目
YUNXIAO_PROJECT_ID=*
YUNXIAO_SYNC_INTERVAL_SECONDS=300

# 可选：自托管 Langfuse。不配密钥或 LANGFUSE_ENABLED=false 则不上报。
# 本机初始化：backend/venv/bin/python infra/langfuse/setup.py
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local
