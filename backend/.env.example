# 云效 Bug 修复 Agent - 环境配置示例
# 复制此文件为 .env 并填入实际配置

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173"]

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/yunxiao_agent.db

# Agent 配置
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT=1800

# 工作目录
WORKTREES_DIR=.worktrees

# 日志
LOG_LEVEL=INFO

# LLM 配置 - Claude 中转 API
CLAUDE_RELAY_BASE_URL=https://your-claude-relay-api.com/v1
CLAUDE_RELAY_API_KEY=your-claude-api-key
CLAUDE_DEFAULT_MODEL=claude-opus-5

# LLM 配置 - Grok 中转 API
GROK_RELAY_BASE_URL=https://your-grok-relay-api.com/v1
GROK_RELAY_API_KEY=your-grok-api-key
GROK_DEFAULT_MODEL=grok-2-latest

# 云效 MCP 配置
YUNXIAO_API_BASE=https://openapi-rdc.aliyuncs.com
YUNXIAO_ACCESS_TOKEN=your-token
YUNXIAO_ORG_ID=your-org-id
# * means all accessible projects in this organization.
YUNXIAO_PROJECT_ID=*
